{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.photographer.app",
  "build": {
    "beforeBuildCommand": "python3 scripts/macos_runtime.py audit src-tauri/resources/gphoto && npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Photographer",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": true,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 13 },
        "visible": false,
        "backgroundColor": "#0E0F12"
      },
      {
        "label": "splash",
        "title": "Photographer",
        "url": "splash",
        "width": 460,
        "height": 300,
        "resizable": false,
        "decorations": false,
        "backgroundColor": "#0E0F12",
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "resources": {
      "resources/gphoto/": "gphoto/",
      "resources/licenses/": "licenses/"
    },
    "macOS": {
      "minimumSystemVersion": "14.4"
    }
  }
}
