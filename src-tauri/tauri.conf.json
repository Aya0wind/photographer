{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Photographer",
  "version": "0.1.0-alpha",
  "identifier": "photographer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:2420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Photographer",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "dragDropEnabled": false,
        "visible": false,
        "backgroundColor": "#0E0F12"
      },
      {
        "label": "splash",
        "title": "Photographer",
        "url": "splash",
        "width": 460,
        "height": 300,
        "resizable": false,
        "decorations": false,
        "center": true,
        "backgroundColor": "#0E0F12"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "resources/gphoto/": "gphoto/",
      "resources/licenses/": "licenses/",
      "resources/installer/purge-user-data.ps1": "purge-user-data.ps1"
    },
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "nsis/hooks.nsh"
      },
      "wix": {
        "language": "zh-CN"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
